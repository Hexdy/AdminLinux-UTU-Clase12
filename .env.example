# Ejemplo de variables de entorno para tus scripts.
# COPIÁ este archivo a ".env" y poné TUS valores:
#   cp .env.example .env && chmod 600 .env
# El archivo ".env" real está ignorado por .gitignore: NUNCA se sube al repo.
#
# Desde el script se cargan así:
#   set -a; source "$(dirname "$0")/.env"; set +a
# (y si no existe, el script tiene que avisar y salir con codigo 2)

LOG_DIR=/var/log/miapp
UMBRAL_ERRORES=20
TAG_LOGGER=mantenimiento-logs
API_TOKEN=cambiame
