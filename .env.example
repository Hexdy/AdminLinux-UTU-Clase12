# Ejemplo de variables de entorno. COPIÁ este archivo a ".env" y poné TUS valores.
#   cp .env.example .env && chmod 600 .env
# El archivo ".env" real está ignorado por .gitignore: NUNCA se sube al repo.
# En el script se carga con:  source .env
# (ver Clase 12 §12 — Security by design: cero secretos hardcodeados)

UMBRAL_ERRORES=10
RUTA_LOG=datos/app.log
API_TOKEN=cambiame
